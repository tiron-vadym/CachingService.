# Database URL (SQLite or PostgreSQL)
# Examples:
# SQLite (async): sqlite+aiosqlite:///./cache_service.db
# PostgreSQL (async): postgresql+asyncpg://postgres:postgres@localhost:5432/cache_service
DATABASE_URL=sqlite+aiosqlite:///./cache_service.db

# Server configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Simulated external service delay in seconds (set to 0 for instant tests)
TRANSFORMER_DELAY_SECONDS=0.05
